<script>
document.addEventListener('DOMContentLoaded', function() {
    let orphansData = [];
    let duplicatesLoaded = false;
    let integrityLoaded = false;
    let currentSortCol = 'relativePath';
    let currentSortAsc = true;

    // Utilitaires
    function formatBytes(bytes) {
        if (bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }

    function escapeHtml(str) {
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function showNotification(message, type = 'success') {
        const notif = document.getElementById('ajaxNotification');
        const notifText = document.getElementById('ajaxNotificationText');
        notif.className = 'alert alert-dismissible alert-' + (type === 'success' ? 'success' : (type === 'warning' ? 'warning' : 'danger'));
        notifText.innerHTML = message;
        notif.style.display = 'block';
    }

    // Gestion du tri des colonnes
    function sortOrphans(col) {
        if (currentSortCol === col) {
            currentSortAsc = !currentSortAsc;
        } else {
            currentSortCol = col;
            currentSortAsc = true;
        }

        orphansData.sort((a, b) => {
            let valA = a[col] ?? '';
            let valB = b[col] ?? '';

            if (typeof valA === 'string') {
                valA = valA.toLowerCase();
                valB = String(valB).toLowerCase();
            }

            if (valA < valB) return currentSortAsc ? -1 : 1;
            if (valA > valB) return currentSortAsc ? 1 : -1;
            return 0;
        });

        updateSortIcons();
        renderOrphansTable();
    }

    function updateSortIcons() {
        document.querySelectorAll('#tableOrphans .sortable-col').forEach(th => {
            const col = th.getAttribute('data-sort');
            const icon = th.querySelector('.sort-icon');
            if (!icon) return;

            if (col === currentSortCol) {
                icon.className = 'sort-icon glyphicon ' + (currentSortAsc ? 'glyphicon-chevron-up text-primary' : 'glyphicon-chevron-down text-primary');
            } else {
                icon.className = 'sort-icon glyphicon glyphicon-sort text-muted';
            }
        });
    }

    document.querySelectorAll('#tableOrphans .sortable-col').forEach(th => {
        th.addEventListener('click', function() {
            const col = this.getAttribute('data-sort');
            if (col) sortOrphans(col);
        });
    });

    // Gestion des onglets
    const tabs = document.querySelectorAll('.tabs-django .tab-dj');
    tabs.forEach(tab => {
        tab.addEventListener('click', function() {
            tabs.forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.pane-dj').forEach(p => p.classList.remove('active'));

            this.classList.add('active');
            const targetId = this.getAttribute('data-target');
            const targetPane = document.getElementById(targetId);
            if (targetPane) targetPane.classList.add('active');

            if (targetId === 'dj-duplicates' && !duplicatesLoaded) {
                loadDuplicates();
            }
            if (targetId === 'dj-integrity' && !integrityLoaded) {
                loadIntegrity();
            }
        });
    });

    // 1. Chargement des Orphelins (AJAX)
    function loadOrphans() {
        document.getElementById('orphansLoading').style.display = 'block';
        document.getElementById('orphansContainer').style.display = 'none';
        document.getElementById('orphansEmpty').style.display = 'none';

        fetch('audit_orphelins.php?action=scan_orphans')
            .then(res => res.json())
            .then(data => {
                document.getElementById('orphansLoading').style.display = 'none';
                if (!data.success) {
                    showNotification('Erreur lors du scan : ' + data.error, 'danger');
                    return;
                }
                orphansData = data.orphans || [];
                updateOrphansUI(data.totalSize || 0);
            })
            .catch(err => {
                document.getElementById('orphansLoading').style.display = 'none';
                showNotification('Erreur réseau lors du scan des orphelins : ' + err.message, 'danger');
            });
    }

    function updateOrphansUI(totalSizeOverride = null) {
        const count = orphansData.length;
        document.getElementById('orphanCount').textContent = count;
        document.getElementById('badgeOrphansCount').textContent = count;

        let totalSize = totalSizeOverride !== null ? totalSizeOverride : orphansData.reduce((acc, curr) => acc + (curr.size || 0), 0);
        document.getElementById('orphanTotalSize').textContent = formatBytes(totalSize);

        if (count === 0) {
            document.getElementById('orphansEmpty').style.display = 'block';
            document.getElementById('orphansContainer').style.display = 'none';
        } else {
            document.getElementById('orphansEmpty').style.display = 'none';
            document.getElementById('orphansContainer').style.display = 'block';
            renderOrphansTable();
        }
    }

    function renderOrphansTable() {
        const tbody = document.getElementById('orphansTableBody');
        tbody.innerHTML = '';

        orphansData.forEach(orphan => {
            const tr = document.createElement('tr');
            tr.setAttribute('data-relpath', orphan.relativePath);
            tr.innerHTML = `
                <td style="text-align: center;">
                    <input type="checkbox" value="${escapeHtml(orphan.relativePath)}" class="orphan-checkbox">
                </td>
                <td><strong>${escapeHtml(orphan.filename)}</strong></td>
                <td><code>${escapeHtml(orphan.relativePath)}</code></td>
                <td>${escapeHtml(orphan.formattedSize)}</td>
                <td>${escapeHtml(orphan.formattedDate)}</td>
            `;
            tbody.appendChild(tr);
        });
        bindCheckboxEvents();
    }

    function bindCheckboxEvents() {
        document.querySelectorAll('.orphan-checkbox').forEach(cb => cb.addEventListener('change', updateSelectedCount));
        updateSelectedCount();
    }

    function updateSelectedCount() {
        const selected = document.querySelectorAll('.orphan-checkbox:checked');
        document.getElementById('selectedCount').textContent = selected.length;
    }

    document.getElementById('btnSelectAllOrphans').addEventListener('click', function() {
        document.querySelectorAll('.orphan-checkbox').forEach(cb => cb.checked = true);
        updateSelectedCount();
    });

    document.getElementById('btnDeselectAllOrphans').addEventListener('click', function() {
        document.querySelectorAll('.orphan-checkbox').forEach(cb => cb.checked = false);
        updateSelectedCount();
    });

    // 2. Suppression dynamique orphelins sans rescan
    document.getElementById('btnDeleteSelected').addEventListener('click', function() {
        const selectedCbs = Array.from(document.querySelectorAll('.orphan-checkbox:checked'));
        if (selectedCbs.length === 0) {
            alert('Veuillez sélectionner au moins un fichier orphelin.');
            return;
        }

        const relativePaths = selectedCbs.map(cb => cb.value);
        if (!confirm(`Supprimer définitivement ${relativePaths.length} fichier(s) orphelin(s) ?`)) return;

        const btn = this;
        btn.disabled = true;

        fetch('audit_orphelins.php?action=delete_orphans', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ orphan_files: relativePaths })
        })
        .then(res => res.json())
        .then(data => {
            btn.disabled = false;
            if (!data.success) {
                showNotification('Erreur lors de la suppression : ' + data.error, 'danger');
                return;
            }

            (data.deletedFiles || relativePaths).forEach(relPath => {
                const tr = document.querySelector(`tr[data-relpath="${CSS.escape(relPath)}"]`);
                if (tr) {
                    tr.classList.add('row-deleted');
                    setTimeout(() => tr.remove(), 400);
                }
                orphansData = orphansData.filter(o => o.relativePath !== relPath);
            });

            setTimeout(() => {
                updateOrphansUI();
                showNotification(`<strong>${data.deletedCount}</strong> fichier(s) orphelin(s) supprimé(s) avec succès !`, 'success');
            }, 450);
        })
        .catch(err => {
            btn.disabled = false;
            showNotification('Erreur réseau lors de la suppression : ' + err.message, 'danger');
        });
    });

    // 3. Lazy Loading Doublons (AJAX)
    function loadDuplicates() {
        duplicatesLoaded = true;
        document.getElementById('duplicatesNotLoaded').style.display = 'none';
        document.getElementById('duplicatesLoading').style.display = 'block';

        fetch('audit_orphelins.php?action=scan_duplicates')
            .then(res => res.json())
            .then(data => {
                document.getElementById('duplicatesLoading').style.display = 'none';
                if (!data.success) {
                    showNotification('Erreur lors du scan des doublons : ' + data.error, 'danger');
                    return;
                }

                const duplicates = data.duplicates || [];
                document.getElementById('duplicateCount').textContent = duplicates.length;
                document.getElementById('badgeDuplicatesCount').textContent = duplicates.length;
                document.getElementById('duplicateTotalWasted').textContent = formatBytes(data.totalWastedSize || 0);

                const container = document.getElementById('duplicatesList');
                container.innerHTML = '';

                if (duplicates.length === 0) {
                    document.getElementById('duplicatesEmpty').style.display = 'block';
                } else {
                    document.getElementById('duplicatesContainer').style.display = 'block';

                    duplicates.forEach((dupGroup, idx) => {
                        const panel = document.createElement('div');
                        panel.className = 'panel panel-default';

                        let rowsHtml = '';
                        dupGroup.files.forEach(f => {
                            let refBtnHtml = (f.reference && f.reference.url) 
                                ? `<a href="${escapeHtml(f.reference.url)}" target="_blank" class="btn btn-xs btn-info"><span class="glyphicon glyphicon-eye-open"></span> Voir ${escapeHtml(f.reference.label)}</a>`
                                : `<span class="text-muted"><em style="font-size: 11px;">(Non référencé)</em></span>`;

                            rowsHtml += `
                                <tr>
                                    <td><strong>${escapeHtml(f.filename)}</strong></td>
                                    <td><code>${escapeHtml(f.relativePath)}</code></td>
                                    <td>${escapeHtml(f.formattedSize)}</td>
                                    <td>${escapeHtml(f.formattedDate)}</td>
                                    <td>${refBtnHtml}</td>
                                </tr>
                            `;
                        });

                        panel.innerHTML = `
                            <div class="panel-heading" style="display: flex; justify-content: space-between; align-items: center;">
                                <span><strong>Groupe #${idx + 1}</strong> — Hash MD5 : <code>${escapeHtml(dupGroup.hash)}</code></span>
                                <span class="label label-warning">${dupGroup.count} exemplaires (Gaspillage : ${escapeHtml(dupGroup.formattedWastedSize)})</span>
                            </div>
                            <div class="panel-body" style="padding: 0;">
                                <table class="table table-condensed table-striped" style="margin-bottom: 0;">
                                    <thead>
                                        <tr>
                                            <th>Nom du fichier</th>
                                            <th>Chemin relatif</th>
                                            <th>Taille</th>
                                            <th>Dernière modification</th>
                                            <th>Élément associé</th>
                                        </tr>
                                    </thead>
                                    <tbody>${rowsHtml}</tbody>
                                </table>
                            </div>
                        `;
                        container.appendChild(panel);
                    });
                }
            })
            .catch(err => {
                document.getElementById('duplicatesLoading').style.display = 'none';
                showNotification('Erreur réseau doublons : ' + err.message, 'danger');
            });
    }

    // 4. Lazy Loading Intégrité Globale (AJAX)
    function loadIntegrity() {
        integrityLoaded = true;
        document.getElementById('integrityNotLoaded').style.display = 'none';
        document.getElementById('integrityLoading').style.display = 'block';

        fetch('audit_orphelins.php?action=scan_integrity')
            .then(res => res.json())
            .then(data => {
                document.getElementById('integrityLoading').style.display = 'none';
                if (!data.success) {
                    showNotification('Erreur scan intégrité : ' + data.error, 'danger');
                    return;
                }

                document.getElementById('integrityContainer').style.display = 'block';

                const dirs = data.orphanDirs || [];
                const missing = data.missingFiles || [];
                const relations = data.orphanRelations || [];
                const totalAnomalies = dirs.length + missing.length + relations.length;

                document.getElementById('integrityTotalAnomalies').textContent = totalAnomalies;
                document.getElementById('badgeIntegrityCount').textContent = totalAnomalies;
                document.getElementById('integrityStatus').textContent = totalAnomalies === 0 ? 'Excellente (0)' : `${totalAnomalies} anomalie(s)`;

                // A. Dossiers Orphelins
                document.getElementById('orphanDirsCount').textContent = dirs.length;
                const dirsTbody = document.getElementById('orphanDirsTableBody');
                dirsTbody.innerHTML = '';
                if (dirs.length === 0) {
                    document.getElementById('orphanDirsEmpty').style.display = 'block';
                    document.getElementById('orphanDirsTableWrapper').style.display = 'none';
                } else {
                    document.getElementById('orphanDirsEmpty').style.display = 'none';
                    document.getElementById('orphanDirsTableWrapper').style.display = 'block';
                    dirs.forEach(d => {
                        const tr = document.createElement('tr');
                        tr.setAttribute('data-dir', d.relativePath);
                        tr.innerHTML = `
                            <td><span class="label label-danger">${escapeHtml(d.domain)}</span></td>
                            <td><strong>#${d.id}</strong></td>
                            <td><code>${escapeHtml(d.relativePath)}</code></td>
                            <td>${d.fileCount} fichier(s)</td>
                            <td>${escapeHtml(d.formattedSize)}</td>
                            <td>
                                <button type="button" class="btn btn-xs btn-danger btn-delete-dir" data-dir="${escapeHtml(d.relativePath)}">
                                    <span class="glyphicon glyphicon-trash"></span> Supprimer dossier
                                </button>
                            </td>
                        `;
                        dirsTbody.appendChild(tr);
                    });

                    document.querySelectorAll('.btn-delete-dir').forEach(btn => {
                        btn.addEventListener('click', function() {
                            const relDir = this.getAttribute('data-dir');
                            if (!confirm(`Supprimer définitivement le dossier orphelin "${relDir}" et tout son contenu ?`)) return;

                            fetch('audit_orphelins.php?action=delete_orphan_dir', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ rel_dir: relDir })
                            })
                            .then(r => r.json())
                            .then(res => {
                                if (res.success) {
                                    const tr = document.querySelector(`tr[data-dir="${CSS.escape(relDir)}"]`);
                                    if (tr) tr.remove();
                                    showNotification(`Dossier orphelin "${relDir}" supprimé avec succès !`, 'success');
                                } else {
                                    showNotification('Erreur suppression dossier : ' + (res.error || 'Échec'), 'danger');
                                }
                            });
                        });
                    });
                }

                // B. Fichiers BDD Manquants
                document.getElementById('missingFilesCount').textContent = missing.length;
                const missingTbody = document.getElementById('missingFilesTableBody');
                missingTbody.innerHTML = '';
                if (missing.length === 0) {
                    document.getElementById('missingFilesEmpty').style.display = 'block';
                    document.getElementById('missingFilesTableWrapper').style.display = 'none';
                } else {
                    document.getElementById('missingFilesEmpty').style.display = 'none';
                    document.getElementById('missingFilesTableWrapper').style.display = 'block';
                    missing.forEach(m => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td><span class="label label-warning">${escapeHtml(m.source)}</span></td>
                            <td><strong>${escapeHtml(m.filename)}</strong></td>
                            <td><code>${escapeHtml(m.relativePath)}</code></td>
                            <td>${escapeHtml(m.entityLabel)}</td>
                            <td><a href="${escapeHtml(m.editUrl)}" target="_blank" class="btn btn-xs btn-primary"><span class="glyphicon glyphicon-edit"></span> Éditer</a></td>
                        `;
                        missingTbody.appendChild(tr);
                    });
                }

                // C. Liaisons SQL Orphelines
                document.getElementById('orphanRelationsCount').textContent = relations.length;
                const relList = document.getElementById('orphanRelationsList');
                const btnCleanRel = document.getElementById('btnCleanRelations');
                relList.innerHTML = '';
                if (relations.length === 0) {
                    document.getElementById('orphanRelationsEmpty').style.display = 'block';
                    btnCleanRel.style.display = 'none';
                } else {
                    document.getElementById('orphanRelationsEmpty').style.display = 'none';
                    btnCleanRel.style.display = 'inline-block';
                    relations.forEach(r => {
                        const li = document.createElement('li');
                        li.className = 'list-group-item list-group-item-warning';
                        li.innerHTML = `<strong>Table ${escapeHtml(r.table)}</strong> (ID #${r.id}) : ${escapeHtml(r.details)}`;
                        relList.appendChild(li);
                    });
                }
            })
            .catch(err => {
                document.getElementById('integrityLoading').style.display = 'none';
                showNotification('Erreur réseau intégrité : ' + err.message, 'danger');
            });
    }

    // Bouton de nettoyage des liaisons caduques
    document.getElementById('btnCleanRelations').addEventListener('click', function() {
        if (!confirm('Supprimer automatiquement toutes les entrées SQL de liaison devenues caduques ?')) return;

        fetch('audit_orphelins.php?action=clean_orphan_relations', { method: 'POST' })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    showNotification(`<strong>${data.cleanedCount}</strong> liaison(s) SQL caduque(s) nettoyée(s) !`, 'success');
                    loadIntegrity();
                } else {
                    showNotification('Erreur lors du nettoyage : ' + data.error, 'danger');
                }
            });
    });

    // Démarrer avec les orphelins
    loadOrphans();
});
</script>
